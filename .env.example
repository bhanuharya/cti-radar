# Copy to .server.env (or export) and fill in YOUR values.
# NOTE: real .server.env / .env is gitignored — never commit secrets.

# ---- Login credentials (dashboard) ----
# Used by the login page (HTTP Basic on POST /api/login). On success the
# server issues an HttpOnly session cookie; the browser rides that cookie.
CTI_USER=cti_admin
CTI_PASSWORD=change-me-to-a-long-random-string

# ---- API token (headless / scripted scans) ----
# For non-browser workflows (curl / cron / CI). Send as header:
#   curl -H "X-CTI-Token: $CTI_SCAN_TOKEN" -X POST http://HOST/api/orgs/<slug>/scan
# The session cookie ALSO works for these endpoints — this token is the
# no-browser path.
CTI_SCAN_TOKEN=change-me-to-a-long-random-string-2

# Optional — AI-assisted scanning (mode=ai). Choose one of:
# 1) Dashboard Models section (preferred, generic, no presets) — merges one
#    profile into the AI config file; existing profiles are preserved.
# 2) Single-profile env (no file edit; additive, file wins on name clash):
# CTI_AI_PROFILE_NAME=my-model
# CTI_AI_PROVIDER=openai-compatible   # or ollama
# CTI_AI_BASE_URL=https://api.example.com/v1
# CTI_AI_MODEL=my-model-id
# CTI_AI_API_KEY_ENV=MY_API_KEY       # env name holding the secret (optional for local)
# CTI_AI_API_KEY=                     # optional value; mapped into API_KEY_ENV in memory only
# CTI_AI_TIMEOUT=90
# CTI_AI_MAX_HOSTS=10
# CTI_AI_MAX_TOKENS=1024
# 3) Full file — define profiles in data/ai_config.json (see data/ai_config.example.json)
#    Supports: ollama (native) and openai-compatible (any OpenAI-compatible endpoint).
#    Secrets are referenced via *_env names and loaded from the environment.
# Without AI config, `mode=ai` scans return the deterministic result safely.

# ---- OpenHack active external assessment (disabled unless ALL are set) ----
# Requires written authorization (ROE), exact registered targets, and a
# disposable-container wrapper (not a host-installed assessment binary).
# CTI_OPENHACK_BIN=/usr/local/bin/openhack-disposable-container-wrapper
# CTI_OPENHACK_ACTIVE=1
# CTI_OPENHACK_ISOLATED=1
# CTI_OPENHACK_ALLOWED_DOMAINS=example.com,api.example.com
# CTI_OPENHACK_ROE_EXPIRES=2030-01-01T00:00:00Z
# ---- Vuln-scan active checks (disabled unless ALL are set) ----
# Gates active vuln-scan paths: per-host banner re-check (active:true) and the
# Nuclei template engine (engine:nuclei). Passive lookup needs none of this.
# CTI_VULN_ACTIVE=1
# CTI_VULN_ISOLATED=1
# CTI_VULN_ALLOWED_DOMAINS=example.com,api.example.com
# CTI_VULN_ROE_EXPIRES=2030-01-01T00:00:00Z
# ---- Nuclei template engine (optional active provider for vuln-scan) ----
# Gated by the CTI_VULN_* authorization above (CTI_VULN_ACTIVE=1,
# CTI_VULN_ISOLATED=1, exact CTI_VULN_ALLOWED_DOMAINS, unexpired
# CTI_VULN_ROE_EXPIRES). Findings capped at HIGH; dos/fuzz always excluded.
# CTI_NUCLEI_BIN=/home/you/.local/bin/nuclei   # absolute path, or PATH lookup
# CTI_NUCLEI_TEMPLATES=/home/you/nuclei-templates
# CTI_NUCLEI_SEVERITY=critical,high,medium
# CTI_NUCLEI_TAGS=                             # optional tag allowlist (e.g. cve)
# CTI_NUCLEI_EXCLUDE_TAGS=                     # merged over dos,fuzz,intrusive
# CTI_NUCLEI_RATE_LIMIT=20
# CTI_NUCLEI_TIMEOUT=300                       # per-run budget secs (60-1200)
# CTI_NUCLEI_INTERACTSH=0                      # set 1 to allow OAST templates
# AI config overrides (optional):
# CTI_AI_CONFIG={"default_profile":"hermes-local","profiles":{"hermes-local":{"provider":"ollama","base_url":"http://127.0.0.1:11434","model":"hermes3","timeout":90}}}
# CTI_AI_CONFIG_FILE=/path/to/ai_config.json

# Optional — where mutable org registry/findings/history live.
# Keep this outside the Git checkout for real deployments.
# CTI_DATA_DIR=/home/you/.local/share/cti-radar

# Optional — where runtime caches/state live (default ~/.local/state/cti-radar).
# CTI_STATE_DIR=/home/you/.local/state/cti-radar

# Optional — wildcard-DNS filtering during enumeration (default on).
# Drops subdomain candidates that only echo a wildcard A record.
# CTI_WILDCARD_FILTER=1

# Optional — NVD enrichment for locally matched CVEs (default off).
# When on, matched CVEs get the official CVSS score/vector + description
# from the NVD 2.0 API. Results are disk-cached (24h) and the scan NEVER
# fails if NVD is unreachable (fail-open to the local-map result).
# CTI_NVD_ENRICH=1
# CTI_NVD_API_KEY=            # optional; without it ~5 req/30s rate limit applies
# CTI_NVD_MAX_LOOKUPS=20      # max NVD network calls per scan (cache hits free)

# Optional — where the server binds (default 127.0.0.1). Use an explicit
# private interface address when remote access is required; never use 0.0.0.0.
# CTI_HOST=127.0.0.1
# CTI_PORT=8084
# Optional explicit Chromium executable for PDF reports.
# CTI_CHROMIUM_PATH=/usr/bin/chromium
